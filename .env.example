# ==============================================================================
#                 SCREENSAVER APPLICATION CONFIGURATION (v0.0.2)
# ==============================================================================
# Copy this file to a new file named `.env` and configure your credentials.
# Values in this file drive container compose stacks and native Python environments.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Used by Proxmox Backend & Synology Agent)
# ------------------------------------------------------------------------------

# The hostname or IP address of your PostgreSQL database server.
# - Inside Proxmox Docker-Compose: Use 'db' (resolves to the local db service).
# - On Synology NAS native environment: Change this to your Proxmox server IP.
DB_HOST=localhost

# The name of the database where photo index catalogs are stored.
DB_NAME=screensaver

# The database username authorized to write/read catalog tables.
DB_USER=screensaver_user

# The database password corresponding to the database user.
DB_PASSWORD=screensaver_pass


# ------------------------------------------------------------------------------
# 2. SECURITY CONFIGURATION (Used for API Authorization)
# ------------------------------------------------------------------------------

# The secure API Key header token. It must match between the Synology agent 
# environment and scanning requests. Set a strong unique string here.
API_KEY=my_secure_screensaver_key


# ------------------------------------------------------------------------------
# 3. PROXMOX SERVER CONFIGURATION (Used by Proxmox Compose & Frontend UI)
# ------------------------------------------------------------------------------

# The IP address or domain name where your Proxmox backend API service runs.
# - Used by the Nginx container to tell TV browsers where to fetch photo metadata.
# - Use 'localhost' for local development, or Proxmox host IP for production.
BACKEND_IP=localhost

# The network port exposed by the Proxmox backend FastAPI service container.
# - Default port is 9091. Make sure it doesn't conflict with other services.
BACKEND_PORT=9091


# ------------------------------------------------------------------------------
# 4. SYNOLOGY NAS SERVICE CONFIGURATION (Used by Synology Compose & Frontend UI)
# ------------------------------------------------------------------------------

# The physical IP address of your Synology NAS host where the Python agent runs.
# - Used by Nginx and the browser frontend to load image streams directly from the NAS.
# - Use 'localhost' for local development, or NAS host IP for production.
SYNOLOGY_IP=localhost

# The network port where the Synology agent API listens.
# - Default port is 9090. Make sure it matches the port bound in your NAS script.
SYNOLOGY_PORT=9090


# ------------------------------------------------------------------------------
# 5. SCANNING AGENT PATH DETAILS (Used by Synology Scanner Engine Only)
# ------------------------------------------------------------------------------

# The directory path on the NAS storage filesystem to crawl during scans.
# - Inside Docker: This maps to '/photos' (which points to your volume mount).
# - Native Python (Synology host): Set to your NAS share path (e.g. '/volume2/photo').
PHOTO_DIR=/photos

# A comma-separated list of image file extensions to index during directory walks.
# Keep extensions lowercase and comma-separated without spaces.
PHOTO_EXTENSIONS=.jpg,.jpeg,.png,.heic

# A comma-separated list of directory names, file names, or folder paths to exclude 
# from the catalog index. Skip system, trash, and metadata directories.
PATH_BLACKLIST=@eaDir,#recycle,.DS_Store

# --- DATABASE CONFIGURATION ---
DB_HOST=localhost
DB_NAME=screensaver
DB_USER=screensaver_user
DB_PASSWORD=screensaver_pass

# --- SECURITY ---
API_KEY=my_secure_screensaver_key

# --- SERVICE PORT ---
PORT=9090

# --- SCANNING CONFIGURATION ---
# The path to scan for photos.
# In Docker, this is mapped to /photos in the docker-compose.yml.
# On Synology directly, this would be your photo volume path.
PHOTO_DIR=/photos

# File types and skipped directories
PHOTO_EXTENSIONS=.jpg,.jpeg,.png,.heic
PATH_BLACKLIST=@eaDir,#recycle,.DS_Store

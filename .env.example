# ==============================================================================
#                 SCREENSAVER APPLICATION CONFIGURATION (v0.0.2)
# ==============================================================================
# Copy this file to `.env` and adjust the variables.
# No ports or IPs should be hardcoded in your compose files or python scripts.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# IP address/host of the PostgreSQL server.
# - In Proxmox Compose: set to 'db' (or the Proxmox IP if DB runs on a separate VM).
# - On Synology NAS: set to your Proxmox server IP.
DB_IP=localhost
DB_PORT=5432
DB_NAME=screensaver
DB_USER=screensaver_user
DB_PASSWORD=screensaver_pass

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Nginx Web Server)
# ------------------------------------------------------------------------------
# The IP address and Port where your screensaver website will be accessed.
FRONTEND_IP=localhost
FRONTEND_PORT=8080

# ------------------------------------------------------------------------------
# 3. BACKEND API CONFIGURATION (FastAPI Metadata Service)
# ------------------------------------------------------------------------------
# The IP address/host and Port where the Proxmox backend metadata service runs.
BACKEND_IP=localhost
BACKEND_PORT=9090

# ------------------------------------------------------------------------------
# 4. SYNOLOGY AGENT CONFIGURATION (FastAPI Scan & Stream Service)
# ------------------------------------------------------------------------------
# The IP address/host and Port where your Synology NAS script is running.
SYNOLOGY_IP=localhost
SYNOLOGY_PORT=9092

# ------------------------------------------------------------------------------
# 5. SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Secure token to authenticate scans between frontend and Synology agent.
API_KEY=my_secure_screensaver_key

# ------------------------------------------------------------------------------
# 6. SCANNING CONFIGURATION (Synology Only)
# ------------------------------------------------------------------------------
# Folder path on your NAS containing your photo library.
PHOTO_DIR=/photos

# Allowed image file extensions to index.
PHOTO_EXTENSIONS=.jpg,.jpeg,.png,.heic

# Allowed video file extensions to index.
VIDEO_EXTENSIONS=.mp4,.mov,.webm,.mpg,.mpeg,.m4v

# System directories and folders to skip during directory sweeps.
PATH_BLACKLIST=@eaDir,#recycle,.DS_Store

# ------------------------------------------------------------------------------
# 7. TELEGRAM NOTIFICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Token provided by BotFather (e.g. 123456789:ABCdefGh...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Chat ID where you want messages sent (e.g. 987654321)
TELEGRAM_CHAT_ID=your_telegram_chat_id
